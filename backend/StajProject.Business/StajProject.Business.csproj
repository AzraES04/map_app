<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- DTO açıklamaları da Swagger'da görünsün (şema alanlarının anlamı) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ödev 10: 81 ilin sınırları. GÖMÜLÜ KAYNAK olarak taşınıyor, dosya
         olarak değil: çalışma dizinine göre yol aramak (bin\Debug\...) hem
         geliştirme hem yayın ortamında farklı davranır ve sessizce
         "dosya bulunamadı" ile biterdi. Gömülü kaynak derlemenin içinde. -->
    <EmbeddedResource Include="../db/tr-iller.geojson" Link="Data/tr-iller.geojson" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StajProject.DataAccess\StajProject.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test derlemesi 'internal' uyeleri gorebilsin.

         Neden bu yol? AuthService.Ozetle bir IC DETAY: yenileme anahtarinin
         nasil ozetlendigi servisin sozlesmesinin parcasi degil, disaridan
         cagrilmamali. Ama testin veritabanindaki dogru satiri bulabilmesi
         icin ayni ozeti hesaplamasi gerekiyor.

         Uyeyi public yapmak, sirf test icin genel API'yi genisletmek olurdu.
         InternalsVisibleTo tam olarak "gizli, ama testler gorebilir"
         demenin yolu. -->
    <InternalsVisibleTo Include="StajProject.Tests" />
  </ItemGroup>

</Project>
